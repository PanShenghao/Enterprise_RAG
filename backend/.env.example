# ============================================================
# RAG + Agent 管理系统 · 环境配置（示例）
#  复制本文件为 backend/.env 后填写真实值
#  @Author  : psh
# ============================================================

# ===== 应用配置 =====
APP_NAME=RAG Agent System
APP_ENV=dev
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=true

# ===== 大模型（阿里云 DashScope / 通义千问 Qwen）=====
DASHSCOPE_API_KEY=your-dashscope-api-key
LLM_MODEL=qwen-plus
EMBEDDING_MODEL=text-embedding-v1

# ===== 向量数据库 Milvus =====
MILVUS_HOST=127.0.0.1
MILVUS_PORT=19530
MILVUS_URI=http://127.0.0.1:19530
MILVUS_COLLECTION=rag_knowledge
MILVUS_MEMORY_COLLECTION=rag_memory
MILVUS_DIMENSION=1536

# ===== Redis =====
REDIS_URL=redis://:your-password@127.0.0.1:6379
REDIS_DB=0

# ===== PostgreSQL =====
POSTGRES_DSN=postgresql://postgres:your-password@127.0.0.1:5432/rag_agent
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your-password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=rag_agent

# ===== 博查 Web Search（预留）=====
BOCHA_API_KEY=
BOCHA_ENDPOINT=https://api.bocha.cn/v1/web-search

# ===== OCR 文档解析（百度 Paddle-VL Parser，可选）=====
OCR_ENABLED=false
OCR_ACCESS_TOKEN=
OCR_CLIENT_ID=
OCR_CLIENT_SECRET=
OCR_TOKEN_URL=https://aip.baidubce.com/oauth/2.0/token
OCR_TASK_URL=https://aip.baidubce.com/rest/2.0/brain/online/v2/paddle-vl-parser/task
OCR_QUERY_URL=https://aip.baidubce.com/rest/2.0/brain/online/v2/paddle-vl-parser/task/query
OCR_POLL_INTERVAL_SEC=3
OCR_POLL_MAX_ATTEMPTS=20
OCR_PDF_MIN_PAGE_CHARS=40
OCR_PDF_EMPTY_PAGE_RATIO=0.5
OCR_PDF_LOW_TEXT_AVG_CHARS=120
OCR_DOCX_MIN_CHARS=120
OCR_TABLE_LIKE_LINE_THRESHOLD=3

# ===== RAG 业务参数 =====
CHUNK_SIZE=500
CHUNK_OVERLAP=50
RETRIEVAL_TOP_K=5
VECTOR_CANDIDATES=20
BM25_CANDIDATES=20

# ===== Text2SQL（预留）=====
SQL_MAX_ROWS=100
SQL_READONLY=true
